  <aside class="sidebar" id="sidebar">
{{#navTabs}}{{#-first}}    <div class="nav-tabs" role="tablist" aria-label="Documentation areas" hidden>
{{/-first}}      <button class="nav-tab" type="button" role="tab" data-nav-tab="{{area}}" aria-selected="{{#current}}true{{/current}}{{^current}}false{{/current}}">{{title}}</button>
{{#-last}}    </div>
{{/-last}}{{/navTabs}}
    <nav aria-label="Documentation">
{{#navigation}}
      <details class="nav-section" data-area="{{area}}"{{#current}} open{{/current}}{{#home}} open{{/home}}>
        <summary>{{title}}</summary>
{{#groups}}
{{#label}}        <div class="nav-group">{{label}}</div>
{{/label}}        <ul>
{{#items}}
          <li><a href="{{basePath}}{{url}}" class="{{#current}}is-current{{/current}}{{#deprecated}} is-deprecated{{/deprecated}}"{{#current}} aria-current="page"{{/current}}>{{title}}</a></li>
{{/items}}
        </ul>
{{/groups}}
      </details>
{{/navigation}}
    </nav>
  </aside>
  <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-label="Hide the navigation" aria-controls="sidebar" aria-expanded="true">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
  </button>
