      <header class="doc-header">
        <div class="kicker"><span class="kind kind-{{kind}}">{{kind}}</span><span class="package">{{packageName}}</span></div>
        <div class="doc-title">
          <h1>{{title}}</h1>{{#sourceUrl}}
          <a class="source-link" href="{{sourceUrl}}" rel="noopener" title="View source" aria-label="View the source of {{name}}"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/></svg></a>{{/sourceUrl}}
        </div>
      </header>
{{#deprecated}}      <div class="callout deprecated"><strong>Deprecated.</strong> {{{html}}}</div>
{{/deprecated}}      <pre class="signature"><code>{{{signatureHtml}}}</code></pre>{{#descriptionHtml}}
      <div class="prose">
{{{descriptionHtml}}}
      </div>{{/descriptionHtml}}
{{> partials/parameters}}{{> partials/tags}}
{{#groups}}
      <section class="member-group" id="{{id}}">
        <h2>{{title}}<a class="anchor" href="#{{id}}" aria-label="Permalink">#</a></h2>
{{#members}}
{{> partials/member}}
{{/members}}
      </section>
{{/groups}}
